---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import AvailabilityPanel from '../components/AvailabilityPanel.astro';
import { siteConfig, freelanceMode, showEmail, showPhone } from '../config/site';

const subject = encodeURIComponent(freelanceMode ? 'Job opportunity / project enquiry' : 'Job opportunity');
---
<BaseLayout title="Contact: Hire an ASP.NET Core Developer" description={freelanceMode ? 'Contact Ravi Prakash, senior ASP.NET Core developer, about a full-time role or a .NET, Docker, Kubernetes or Google Cloud project.' : 'Contact Ravi Prakash, senior ASP.NET Core developer open to full-time roles.'}>
  {freelanceMode ? (
    <PageIntro
      eyebrow="Contact"
      title="Let's talk."
      description="I am open to full-time roles, in India or with teams abroad, and to selected remote projects. Send a short note about the role or the work, and I will get back to you."
    />
  ) : (
    <PageIntro
      eyebrow="Contact"
      title="Let's connect."
      description="I am open to full-time senior engineering roles. For opportunities, technical discussions, or professional conversations, feel free to reach out."
    />
  )}

  <section class="contact-panel">
    {showEmail && (
    <div class:list={{ 'contact-primary': freelanceMode }}>
      <span class="contact-icon">✉</span>
      <h2>Email</h2>
      {freelanceMode ? (
        <>
          <p>The best way to start. Helpful things to include:</p>
          <ul class="enquiry-list">
            <li>For a role: the company, position and location (on-site, hybrid or remote)</li>
            <li>For a project: what you are building and the current tech stack</li>
            <li>Your timeline and your team's time zone</li>
          </ul>
        </>
      ) : (
        <p>The best way to reach me.</p>
      )}
      <a class="button button-primary" href={`mailto:${siteConfig.email}?subject=${subject}`}>{siteConfig.email}</a>
    </div>
    )}
    <div>
      <span class="contact-icon">↗</span>
      <h2>LinkedIn</h2>
      <p>See my professional background or send a message.</p>
      <a class="text-link" href={siteConfig.social.linkedin} target="_blank" rel="noreferrer">View LinkedIn profile <span aria-hidden="true">↗</span></a>
    </div>
    <div>
      <span class="contact-icon">⌘</span>
      <h2>GitHub</h2>
      <p>Code samples and technical notes.</p>
      <a class="text-link" href={siteConfig.social.github} target="_blank" rel="noreferrer">View GitHub profile <span aria-hidden="true">↗</span></a>
    </div>
    {showPhone && (
    <div>
      <span class="contact-icon">☎</span>
      <h2>Phone</h2>
      <p>Available for professional contact.</p>
      <a class="text-link" href={`tel:${siteConfig.phone}`}>{siteConfig.phone}</a>
    </div>
    )}
  </section>

  {freelanceMode && (
    <section class="section-block">
      <AvailabilityPanel />
    </section>
  )}
</BaseLayout>
