---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { getPublishedPosts, getAdjacentPosts, getPostUrl, getCategoryUrl, getReadingTime, type Post } from '../../lib/posts';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const { title, description, category, pubDate, updatedDate, tags } = post.data;
const { Content } = await render(post);
const { newer, older } = await getAdjacentPosts(post);
---
<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  schema={[{
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: { '@id': new URL('/#person', Astro.site).href },
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
    keywords: tags.join(', '),
  }]}
>
  <article class="prose-wrap">
    <a class="back-link" href="/blog/">← All articles</a>
    <header class="article-header">
      <a class="category" href={getCategoryUrl(category)}>{category}</a>
      <h1>{title}</h1>
      <p class="article-description">{description}</p>
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, 'long')}</time>
        {updatedDate && <span>Updated {formatDate(updatedDate, 'long')}</span>}
        <span>{getReadingTime(post)} min read</span>
      </div>
    </header>
    <div class="prose"><Content /></div>
    <TagList tags={tags} />
    {(newer || older) && (
      <nav class="post-nav" aria-label="More articles">
        {older ? <a href={getPostUrl(older)}><span>← Older</span>{older.data.title}</a> : <span />}
        {newer && <a class="post-nav-next" href={getPostUrl(newer)}><span>Newer →</span>{newer.data.title}</a>}
      </nav>
    )}
    <div class="article-end"><a class="text-link" href="/blog/">Read more articles <span aria-hidden="true">→</span></a></div>
  </article>
</BaseLayout>
