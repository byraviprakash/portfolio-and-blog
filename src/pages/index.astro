---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import AvailabilityPanel from '../components/AvailabilityPanel.astro';
import CtaBand from '../components/CtaBand.astro';
import { getLatestPosts } from '../lib/posts';
import { siteConfig, skillGroups, experience, workingPrinciples, openTo, freelanceMode } from '../config/site';

const posts = await getLatestPosts(3);
const currentRole = experience[0];
---
<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="hero hero-profile hero-with-photo">
    <div class="hero-main">
    <p class="eyebrow"><span class="eyebrow-dot"></span> {freelanceMode ? siteConfig.remote : siteConfig.location}</p>
    <h1>Senior ASP.NET&nbsp;Core Developer<br /><span>with Docker, Kubernetes<br />&amp; Google Cloud.</span></h1>
    <p class="hero-copy">
      I am a .NET developer with hands-on experience in both development and DevOps. I build
      ASP.NET Core Web APIs and microservices in C#, and I also take them all the way to production: containerized with Docker,
      shipped through CI/CD pipelines, and running on Kubernetes (GKE) on Google Cloud.
      {freelanceMode
        ? ' I am open to a full-time role with a company in India or abroad, and to selected remote projects with teams in Europe and the USA.'
        : ' I am open to full-time senior engineering roles.'}
    </p>
    <div class="hero-actions">
      {freelanceMode ? (
        <>
          <a class="button button-primary" href="/contact/">Get in touch <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="/experience/">View experience</a>
        </>
      ) : (
        <>
          <a class="button button-primary" href="/experience/">View experience <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="/blog/">Read articles</a>
        </>
      )}
    </div>
    <div class="topic-row" aria-label="Core technologies">
      <span>Google Cloud</span><span>Kubernetes (GKE)</span><span>Docker</span><span>CI/CD</span><span>GitHub Actions</span><span>C# / .NET</span><span>ASP.NET Core</span><span>Microservices</span>
    </div>
    </div>
    <figure class="hero-photo">
      <img src="/images/ravi-prakash.jpg" alt="Ravi Prakash, Senior ASP.NET Core Developer" width="800" height="800" loading="eager" />
    </figure>
  </section>

  <section class="stats-row" aria-label="Professional highlights">
    <div class="stat-item"><strong>7+ years</strong><span>Building .NET systems, now cloud-native on GCP</span></div>
    <div class="stat-item"><strong>Dev + DevOps</strong><span>I write the code and ship it: Docker, CI/CD, GKE</span></div>
    <div class="stat-item"><strong>3M+</strong><span>Records processed by the platform I work on</span></div>
    <div class="stat-item"><strong>USA client</strong><span>Currently delivering for S&amp;P Global Mobility</span></div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div><p class="eyebrow">Availability</p><h2>What I'm open to</h2></div>
      <a class="text-link" href="/contact/">Get in touch <span aria-hidden="true">→</span></a>
    </div>
    <div class="open-to-grid">
      {openTo.map((item) => (
        <article class="service-card">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  {freelanceMode && (
  <>
  <section class="section-block">
    <div class="section-heading">
      <div><p class="eyebrow">How I can help</p><h2>Services</h2></div>
      <a class="text-link" href="/services/">Service details <span aria-hidden="true">→</span></a>
    </div>
    <ServicesGrid />
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div><p class="eyebrow">Working together</p><h2>Built for remote collaboration</h2></div>
    </div>
    <AvailabilityPanel />
    <ul class="principles-list">
      {workingPrinciples.map((item) => <li>{item}</li>)}
    </ul>
  </section>
  </>
  )}

  <section class="section-block experience-preview">
    <div class="section-heading">
      <div><p class="eyebrow">Current work</p><h2>{currentRole.role}</h2></div>
      <a class="text-link" href="/experience/">Full experience <span aria-hidden="true">→</span></a>
    </div>
    <div class="current-role-card">
      <div class="role-heading">
        <div>
          <h3>{currentRole.client}</h3>
          <p>{currentRole.clientNote} · via {currentRole.company}</p>
        </div>
        <span class="role-period">{currentRole.period}</span>
      </div>
      <ul>
        {currentRole.highlights.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div><p class="eyebrow">Technology</p><h2>Technical skills</h2></div>
      <a class="text-link" href="/about/">More about me <span aria-hidden="true">→</span></a>
    </div>
    <div class="skills-grid">
      {skillGroups.map((group) => (
        <div class="skill-card">
          <h3>{group.title}</h3>
          <div class="tag-list">{group.skills.map((skill) => <span>{skill}</span>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div><p class="eyebrow">Technical writing</p><h2>Latest articles</h2></div>
      <a class="text-link" href="/blog/">View all articles <span aria-hidden="true">→</span></a>
    </div>
    <ArticleList posts={posts} layout="grid" emptyTitle="Technical notes are coming here." />
  </section>

  {freelanceMode && <CtaBand />}
</BaseLayout>
