---
import { siteConfig, navigation } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 'article' for blog posts, 'website' for everything else */
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Extra schema.org objects for this page (merged into the JSON-LD graph) */
  schema?: Record<string, unknown>[];
}
const { title = siteConfig.name, description = siteConfig.description, type = 'website', publishedTime, schema = [] } = Astro.props;
const pageTitle = title === siteConfig.name ? siteConfig.seoTitle : `${title} | ${siteConfig.name}`;
const siteUrl = Astro.site ?? new URL(siteConfig.url);
const canonical = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(siteConfig.image, siteUrl);
const personId = new URL('/#person', siteUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: siteConfig.name,
      jobTitle: siteConfig.jobTitle,
      description: siteConfig.description,
      url: siteUrl.href,
      image: imageUrl.href,
      email: `mailto:${siteConfig.email}`,
      address: { '@type': 'PostalAddress', addressLocality: 'New Delhi', addressCountry: 'IN' },
      knowsAbout: siteConfig.knowsAbout,
      sameAs: [siteConfig.social.github, siteConfig.social.linkedin],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', siteUrl).href,
      url: siteUrl.href,
      name: siteConfig.name,
      author: { '@id': personId },
      inLanguage: 'en',
    },
    ...schema,
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="author" content={siteConfig.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={`${siteConfig.name}, ${siteConfig.jobTitle}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="CodeToCloud by Ravi Prakash, home">
          <img class="brand-icon" src="/images/logo-icon.png" alt="" width="200" height="200" />
          <span class="brand-words">
            <span class="brand-name">CodeToCloud</span>
            <span class="brand-by">by Ravi Prakash</span>
            <span class="brand-tag">Programming Notes | Cloud Deployment</span>
          </span>
        </a>
        <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
          <span></span><span></span><span></span>
        </button>
        <nav id="site-nav" aria-label="Main navigation">
          {navigation.map((item) => (
            <a href={item.href} class:list={{ active: Astro.url.pathname === item.href || (item.href === '/blog/' && Astro.url.pathname.startsWith('/blog/')) }}>
              {item.label}
            </a>
          ))}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {siteConfig.name}</span>
        <span>{siteConfig.role} · {siteConfig.remote} · <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></span>
      </footer>
    </div>
    <script>
      // Mobile hamburger menu: open/close the navigation
      const header = document.querySelector('.site-header');
      const toggle = header?.querySelector('.menu-toggle');
      const setOpen = (open) => {
        header?.classList.toggle('menu-open', open);
        toggle?.setAttribute('aria-expanded', String(open));
        toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      toggle?.addEventListener('click', () => setOpen(!header?.classList.contains('menu-open')));
      header?.querySelectorAll('nav a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
      window.matchMedia('(min-width: 761px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
    </script>
  </body>
</html>
